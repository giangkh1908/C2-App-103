{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10,
            "statusMessage": "Logging Codex prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10,
            "statusMessage": "Logging Codex turn"
          }
        ]
      }
    ]
  }
}