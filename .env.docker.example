# Docker runtime/build environment.
# Copy this file to .env.docker, then fill real secrets before running Docker Compose.

# App mode
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Public URLs for running on localhost with Docker
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Toan Truc Quan AI
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api/v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DB_NAME=toan_truc_quan

# Auth
# Must be a real 32+ character secret in APP_ENV=production.
# Generate one with PowerShell:
# $bytes = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
# Do not use the placeholder below unchanged.
JWT_SECRET_KEY=replace-with-32-plus-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# LLM
# Backend supports OpenRouter for the learning core.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=mathbuddy-ai-backend

# Optional email
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Optional Langfuse
# Set BACKEND_EXTRAS=observability when building the backend image with Langfuse enabled.
BACKEND_EXTRAS=
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

# Logging
LOG_FILE_PATH=logs/app.jsonl
LOG_FILE_LEVEL=INFO
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
