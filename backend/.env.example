APP_NAME=toan-truc-quan-backend
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DB_NAME=toan_truc_quan
PRACTICE_ACCEPTANCE_MONGODB_DB_NAME=toan_truc_quan_practice_acceptance
PRACTICE_TEST_MONGODB_URI=mongodb://127.0.0.1:27018
PRACTICE_TEST_MONGODB_DB_NAME=toan_truc_quan_practice_test

JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

FRONTEND_URL=http://localhost:3000

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=mathbuddy-ai-backend
